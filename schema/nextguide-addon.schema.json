{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NextGuide Add-on Manifest v1 (content-only preview)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "summary",
    "description",
    "version",
    "author",
    "repository",
    "license",
    "category",
    "keywords",
    "compatibility",
    "permissions",
    "entrypoints",
    "icon"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "category": {
      "enum": [
        "content",
        "theme",
        "icons",
        "language",
        "ai",
        "oauth",
        "integration",
        "accessibility",
        "other"
      ]
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "nextguide"
      ],
      "properties": {
        "mode": {
          "const": "account"
        },
        "nextguide": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      },
      "description": "Runtime extensions are not enabled in this preview."
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "icon": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.png$",
      "maxLength": 160,
      "description": "A local PNG logo (32–1024 pixels, 256 KiB max) shown in the Account Mode marketplace."
    }
  }
}
